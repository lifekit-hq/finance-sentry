{
  "name": "finance-sentry",
  "version": "1.14.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "TZ=Europe/Dublin ng test",
    "test:ci": "TZ=Europe/Dublin ng test finance-sentry --configuration ci",
    "lint": "node scripts/sync-theme-script.mjs --check && ng lint --max-warnings 0",
    "sync:theme": "node scripts/sync-theme-script.mjs",
    "format": "prettier --write \"src/**/*.{ts,html,scss}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss}\"",
    "e2e": "playwright test",
    "e2e:live": "playwright test --config playwright.live.config.ts",
    "prepare": "git -C .. config core.hooksPath .husky || true"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/**/*.{html,scss,css,json}": [
      "prettier --write"
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.2.1",
    "@angular/cdk": "^22.2.1",
    "@angular/common": "^22.2.1",
    "@angular/compiler": "^22.2.1",
    "@angular/core": "^22.2.1",
    "@angular/forms": "^22.2.1",
    "@angular/platform-browser": "^22.2.1",
    "@angular/platform-browser-dynamic": "^22.2.1",
    "@angular/router": "^22.2.1",
    "@angular/service-worker": "^22.2.1",
    "@lifekit-hq/core": "^2.1.0",
    "@lifekit-hq/elements": "^2.1.0",
    "@lifekit-hq/tokens": "^2.1.0",
    "@lifekit-hq/ui": "^2.1.0",
    "@ngrx/signals": "^22.0.1",
    "@types/chroma-js": "^3.1.2",
    "chart.js": "^4.5.1",
    "chroma-js": "^3.2.0",
    "deep-chat": "^2.5.0",
    "lit": "^3.3.3",
    "lucide-angular": "^1.0.0",
    "rxjs": "^7.8.0",
    "tslib": "^2.6.0",
    "zone.js": "^0.16.0"
  },
  "devDependencies": {
    "@angular-devkit/architect": "^0.2202.1",
    "@angular-devkit/build-angular": "^22.2.1",
    "@angular-devkit/core": "^22.2.1",
    "@angular/build": "^22.2.1",
    "@angular/cli": "^22.2.1",
    "@angular/compiler-cli": "^22.2.1",
    "@angular/language-service": "^22.2.1",
    "@lifekit-hq/config": "^2.0.0",
    "@playwright/test": "^1.62.1",
    "@smarttools/eslint-plugin-rxjs": "^1.0.22",
    "@storybook/angular": "^10.3.5",
    "@types/google.accounts": "^0.0.14",
    "@types/node": "^25.5.0",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "angular-eslint": "22.5.0",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "jsdom": "^29.0.1",
    "lint-staged": "^16.4.0",
    "ng-packagr": "^22.2.4",
    "postcss": "^8.5.9",
    "prettier": "^3.8.1",
    "storybook": "^10.3.5",
    "stylelint": "^17.6.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-prettier": "^5.0.3",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.58.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "undici": "^7.28.1",
    "uuid": "^11.1.1",
    "webpack-dev-server": "^5.2.6",
    "lucide-angular": {
      "@angular/common": "$@angular/common",
      "@angular/core": "$@angular/core"
    }
  }
}
