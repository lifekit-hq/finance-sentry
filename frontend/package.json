{
  "name": "finance-sentry",
  "version": "1.20.0",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "whats-new": "node scripts/build-whats-new.mjs",
    "prestart": "npm run whats-new",
    "start": "ng serve",
    "prebuild": "npm run whats-new",
    "build": "ng build",
    "prebuild:prod": "npm run whats-new",
    "build:prod": "ng build --configuration production",
    "prewatch": "npm run whats-new",
    "watch": "ng build --watch --configuration development",
    "test:scripts": "node --test scripts/*.test.mjs",
    "test": "npm run test:scripts && TZ=Europe/Dublin ng test",
    "test:ci": "npm run test:scripts && TZ=Europe/Dublin ng test finance-sentry --configuration ci",
    "lint": "lifekit-theme-sync --check --csp ../docker/nginx.security-headers.conf --csp ../backend/src/FinanceSentry.Gateway/appsettings.json && ng lint --max-warnings 0",
    "sync:theme": "lifekit-theme-sync --csp ../docker/nginx.security-headers.conf --csp ../backend/src/FinanceSentry.Gateway/appsettings.json",
    "format": "prettier --write \"src/**/*.{ts,html,scss}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss}\"",
    "drift": "lifekit-chrome-check drift src",
    "startup-images": "node scripts/generate-startup-images.mjs",
    "chrome-check": "lifekit-chrome-check --app fs --name \"Finance Sentry\" dist/finance-sentry/browser",
    "e2e": "playwright test",
    "e2e:live": "playwright test --config playwright.live.config.ts",
    "test:screens": "playwright test --config playwright.screens.config.ts --grep-invert \"route scan\"",
    "test:screens:update": "playwright test --config playwright.screens.config.ts --grep \"screen baseline\" --update-snapshots=changed",
    "test:routes": "playwright test --config playwright.screens.config.ts --grep \"route scan\"",
    "prepare": "git -C .. config core.hooksPath .husky || true"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/**/*.{html,scss,css,json}": [
      "prettier --write"
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.2.4",
    "@angular/cdk": "^22.2.6",
    "@angular/common": "^22.2.4",
    "@angular/compiler": "^22.2.4",
    "@angular/core": "^22.2.4",
    "@angular/forms": "^22.2.4",
    "@angular/platform-browser": "^22.2.4",
    "@angular/platform-browser-dynamic": "^22.2.4",
    "@angular/router": "^22.2.4",
    "@angular/service-worker": "^22.2.4",
    "@lifekit-hq/charts-core": "^4.7.1",
    "@lifekit-hq/core": "^4.7.1",
    "@lifekit-hq/elements": "^4.7.1",
    "@lifekit-hq/tokens": "^4.7.1",
    "@lifekit-hq/ui": "^4.7.1",
    "@ngrx/signals": "^22.0.1",
    "chart.js": "^4.6.1",
    "deep-chat": "^2.5.1",
    "lightweight-charts": "^5.2.1",
    "lit": "^3.3.3",
    "lucide-angular": "^1.0.0",
    "rxjs": "^7.8.0",
    "tslib": "^2.9.1",
    "zone.js": "^0.16.3"
  },
  "devDependencies": {
    "@angular-devkit/architect": "^0.2202.6",
    "@angular-devkit/build-angular": "^22.2.3",
    "@angular-devkit/core": "^22.2.6",
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.4",
    "@angular/language-service": "^22.2.4",
    "@lifekit-hq/config": "^4.7.1",
    "@playwright/test": "^1.64.1",
    "@smarttools/eslint-plugin-rxjs": "^1.0.22",
    "@storybook/angular": "^10.6.5",
    "@types/google.accounts": "^0.0.18",
    "@types/node": "^26.6.6",
    "@vitest/browser-playwright": "^5.1.0",
    "@vitest/coverage-v8": "^5.1.0",
    "angular-eslint": "22.6.0",
    "autoprefixer": "^10.6.2",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "ng-packagr": "^22.2.6",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "storybook": "^10.6.5",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-prettier": "^5.0.3",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "undici": "^7.28.1",
    "uuid": "^11.1.1",
    "webpack-dev-server": "^5.2.6",
    "lucide-angular": {
      "@angular/common": "$@angular/common",
      "@angular/core": "$@angular/core"
    }
  }
}
