#!/bin/sh

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
NC='\033[0m'

echo "🔍 Running pre-commit checks..."

echo "📝 Linting and formatting staged frontend files..."

if ! (cd frontend && npx lint-staged); then
  echo -e "${RED}❌ ERROR: lint-staged failed. Fix the errors above before committing.${NC}"
  exit 1
fi

echo -e "${GREEN}✅ All pre-commit checks passed!${NC}"

exit 0