# syntax=docker/dockerfile:1
# Uptime probe (issue #511): bash + curl on alpine, nothing else. Build context: repository root.
FROM alpine:3.22

RUN apk add --no-cache bash curl \
    && adduser -D -u 10001 probe \
    && mkdir -p /var/lib/uptime-probe \
    && chown probe:probe /var/lib/uptime-probe

COPY --chmod=755 docker/uptime-probe.sh /usr/local/bin/uptime-probe.sh

# The compose volume mounted on the state dir starts out owned by `probe`.
USER probe

# Liveness: the loop touches the heartbeat file every cycle (interval 5 min), so a stale one means a wedged loop.
HEALTHCHECK --interval=60s --timeout=5s --retries=3 --start-period=30s \
    CMD find /var/lib/uptime-probe/heartbeat -mmin -15 | grep -q . || exit 1

ENTRYPOINT ["/usr/local/bin/uptime-probe.sh"]
