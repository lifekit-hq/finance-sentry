# Production frontend image — multi-stage:
#   1. build: node:22-alpine installs deps (incl. @lifekit-hq/* from GitHub
#      Packages — needs the npm_token build secret) and builds the Angular app
#      in production mode.
#   2. serve: nginx:alpine serves the SPA with proper history-mode fallback.
#
# Build context: repository root.

# ─── Stage 1: build ────────────────────────────────────────────────────────────
FROM node:26-alpine AS build
WORKDIR /app

COPY frontend/ ./

# @lifekit-hq/* packages come from npm.pkg.github.com (see frontend/.npmrc);
# the token arrives as a BuildKit secret so it never lands in a layer.
RUN --mount=type=secret,id=npm_token \
    NODE_AUTH_TOKEN=$(cat /run/secrets/npm_token) npm install --no-audit --no-fund

# Produce production bundle (dist/finance-sentry/browser/).
RUN npm run build:prod

# ─── Stage 2: serve ────────────────────────────────────────────────────────────
FROM nginx:alpine AS serve

# Platform contract (guardrail 1, spec 048), applied to the image's own nginx.conf:
#   - load the njs module (ships with nginx:alpine) for the /metrics handler — `load_module` is only
#     valid in the main context, which conf.d files never reach;
#   - raise error_log to warn so the `[notice] start worker process` lines stay off stderr — the
#     contract wants ≥90% JSON on stdout+stderr seconds after a recreate, when a container has
#     written only a handful of lines;
#   - NGINX_ENTRYPOINT_QUIET_LOGS silences the entrypoint's `/docker-entrypoint.sh: …` chatter for
#     the same reason.
RUN sed -i '1i load_module modules/ngx_http_js_module.so;' /etc/nginx/nginx.conf \
    && sed -i 's|^error_log  /var/log/nginx/error.log notice;|error_log  /var/log/nginx/error.log warn;|' /etc/nginx/nginx.conf \
    && grep -q '^load_module modules/ngx_http_js_module.so;' /etc/nginx/nginx.conf \
    && grep -q '^error_log  /var/log/nginx/error.log warn;' /etc/nginx/nginx.conf
ENV NGINX_ENTRYPOINT_QUIET_LOGS=1
COPY docker/nginx.metrics.js /etc/nginx/njs/metrics.js

# Default config: SPA fallback to index.html, proxy /api → the api container, plus the contract
# endpoints (/healthz, /readyz, /metrics) and the JSON access log.
RUN rm -f /etc/nginx/conf.d/default.conf
COPY docker/nginx.frontend.conf /etc/nginx/conf.d/finance-sentry.conf

# Copy the built artifacts. The output path comes from angular.json's
# `outputPath` for the `finance-sentry` project — Angular 17+ defaults to
# `<outputPath>/browser`.
COPY --from=build /app/dist/finance-sentry/browser /usr/share/nginx/html

EXPOSE 4200
