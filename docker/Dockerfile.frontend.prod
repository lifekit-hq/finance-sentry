# Production frontend image — multi-stage:
#   1. build: node:22-alpine installs deps (incl. @lifekit-hq/* from GitHub
#      Packages — needs the npm_token build secret) and builds the Angular app
#      in production mode.
#   2. serve: nginx-unprivileged:alpine serves the SPA with proper history-mode fallback. Every
#      nginx process runs as the non-root `nginx` user (uid 101); pid and temp files go to /tmp.
#
# Build context: repository root.

# ─── Stage 1: build ────────────────────────────────────────────────────────────
FROM node:26-alpine AS build
WORKDIR /app

COPY frontend/ ./

# @lifekit-hq/* packages come from npm.pkg.github.com (see frontend/.npmrc);
# the token arrives as a BuildKit secret so it never lands in a layer.
RUN --mount=type=secret,id=npm_token \
    NODE_AUTH_TOKEN=$(cat /run/secrets/npm_token) npm install --no-audit --no-fund

# Produce production bundle (dist/finance-sentry/browser/).
RUN npm run build:prod

# Precompress every text asset (.gz + .br) so nginx serves them with gzip_static / brotli_static.
RUN node scripts/precompress.mjs dist/finance-sentry/browser

# ─── Stage 2: brotli module ────────────────────────────────────────────────────
# nginx-unprivileged ships no brotli module and nginx dynamic modules must match the exact nginx
# version, so build ngx_brotli against the source of the version the serve stage runs — both stages
# run `apk upgrade` first so they resolve the same nginx package.
# Only the static module is built: it serves the build-time .br files and needs no brotli library.
FROM nginxinc/nginx-unprivileged:alpine AS brotli-module
USER root
RUN apk upgrade --no-cache \
    && apk add --no-cache build-base curl git linux-headers openssl-dev pcre2-dev zlib-dev
ARG NGX_BROTLI_REF=a71f9312c2deb28875acc7bacfdd5695a111aa53
RUN set -eux; \
    version="$(nginx -v 2>&1 | sed 's|.*/||')"; \
    curl -fsSL "https://nginx.org/download/nginx-${version}.tar.gz" | tar -xz -C /tmp; \
    git clone https://github.com/google/ngx_brotli /tmp/ngx_brotli; \
    git -C /tmp/ngx_brotli checkout "${NGX_BROTLI_REF}"; \
    git -C /tmp/ngx_brotli submodule update --init --recursive; \
    cd "/tmp/nginx-${version}"; \
    ./configure --with-compat --add-dynamic-module=/tmp/ngx_brotli; \
    make -f objs/Makefile objs/ngx_http_brotli_static_module.so

# ─── Stage 3: serve ────────────────────────────────────────────────────────────
FROM nginxinc/nginx-unprivileged:alpine AS serve

# The base image ends as uid 101; the config edits below need root, and the last line drops back.
USER root

# apk upgrade first: the nginx base image lags Alpine security releases (e.g. pcre2 CVE-2026-103111),
# and the CI Trivy gate fails the image build on any fixable HIGH/CRITICAL finding.
# tiff is pinned to the CVE-2026-4775 fix (4.7.2-r0) so a stale cached upgrade layer cannot ship 4.7.1-r0;
# the build fails loudly if the Alpine repo does not carry it yet. Drop the pin once the base image has it.
RUN apk upgrade --no-cache \
    && apk add --no-cache 'tiff>=4.7.2-r0'

# Platform contract (guardrail 1, spec 048), applied to the image's own nginx.conf:
#   - load the njs module (ships with nginx-unprivileged:alpine) for the /metrics handler —
#     `load_module` is only valid in the main context, which conf.d files never reach;
#   - raise error_log to warn so the `[notice] start worker process` lines stay off stderr — the
#     contract wants ≥90% JSON on stdout+stderr seconds after a recreate, when a container has
#     written only a handful of lines;
#   - NGINX_ENTRYPOINT_QUIET_LOGS silences the entrypoint's `/docker-entrypoint.sh: …` chatter for
#     the same reason.
RUN sed -i '1i load_module modules/ngx_http_js_module.so;' /etc/nginx/nginx.conf \
    && sed -i '1i load_module modules/ngx_http_brotli_static_module.so;' /etc/nginx/nginx.conf \
    && sed -i 's|^error_log  /var/log/nginx/error.log notice;|error_log  /var/log/nginx/error.log warn;|' /etc/nginx/nginx.conf \
    && grep -q '^load_module modules/ngx_http_js_module.so;' /etc/nginx/nginx.conf \
    && grep -q '^load_module modules/ngx_http_brotli_static_module.so;' /etc/nginx/nginx.conf \
    && grep -q '^error_log  /var/log/nginx/error.log warn;' /etc/nginx/nginx.conf
ENV NGINX_ENTRYPOINT_QUIET_LOGS=1
COPY --from=brotli-module /tmp/nginx-*/objs/ngx_http_brotli_static_module.so /usr/lib/nginx/modules/
COPY docker/nginx.metrics.js /etc/nginx/njs/metrics.js

# Default config: SPA fallback to index.html, proxy /api → the api container, plus the contract
# endpoints (/healthz, /readyz, /metrics) and the JSON access log.
RUN rm -f /etc/nginx/conf.d/default.conf
COPY docker/nginx.security-headers.conf /etc/nginx/snippets/security-headers.conf
COPY docker/nginx.frontend.conf /etc/nginx/conf.d/finance-sentry.conf

# Copy the built artifacts. The output path comes from angular.json's
# `outputPath` for the `finance-sentry` project — Angular 17+ defaults to
# `<outputPath>/browser`.
COPY --from=build /app/dist/finance-sentry/browser /usr/share/nginx/html

EXPOSE 4200

USER 101
