# syntax=docker/dockerfile:1
# Multi-stage build for the FinanceSentry edge gateway (feature 025 — YARP reverse proxy).
# Build context: repository root.

# Stage 1: Build
FROM mcr.microsoft.com/dotnet/sdk:10.0-alpine AS build
WORKDIR /src

# Restore into the layer filesystem (not a cache mount): a cache mount's contents are
# non-persistent under BuildKit GC/concurrent-build pressure, so a later RUN (publish)
# reading packages restored by an earlier RUN can find them missing (MSB3030/NETSDK1152).
ENV NUGET_PACKAGES=/src/.nuget/packages

# Project files first so the restore layer only rebuilds when a dependency changes. The gateway's
# project graph is just itself.
COPY backend/Directory.*.props backend/
COPY backend/src/FinanceSentry.Gateway/FinanceSentry.Gateway.csproj backend/src/FinanceSentry.Gateway/

WORKDIR /src/backend
RUN dotnet restore src/FinanceSentry.Gateway/FinanceSentry.Gateway.csproj

WORKDIR /src
COPY backend/ backend/

WORKDIR /src/backend
RUN dotnet build src/FinanceSentry.Gateway/FinanceSentry.Gateway.csproj -c Release --no-restore

RUN dotnet publish src/FinanceSentry.Gateway/FinanceSentry.Gateway.csproj -c Release -o /app/publish --no-build

# Stage 2: Runtime
FROM mcr.microsoft.com/dotnet/aspnet:10.0-alpine AS runtime
WORKDIR /app

COPY --from=build /app/publish .

ENV DOTNET_RUNNING_IN_CONTAINER=true
# Plain HTTP on 8080: TLS is terminated in front of the gateway.
ENV ASPNETCORE_URLS=http://+:8080
EXPOSE 8080

# Run as the image's non-root `app` user.
USER $APP_UID

# Container-level liveness for the single-point-of-failure gateway (spec edge case).
HEALTHCHECK --interval=30s --timeout=5s --retries=3 --start-period=10s \
    CMD wget -q -O /dev/null http://localhost:8080/gateway/health || exit 1

ENTRYPOINT ["dotnet", "FinanceSentry.Gateway.dll"]
