# Angular development server
# Build context: repository root

FROM node:26-alpine

WORKDIR /app

# Install dependencies first (layer cached until package.json changes)
COPY frontend/package*.json frontend/.npmrc ./
# @lifekit-hq/* packages come from npm.pkg.github.com; token via BuildKit secret
RUN --mount=type=secret,id=npm_token \
    NODE_AUTH_TOKEN=$(cat /run/secrets/npm_token) npm install

# Copy source
COPY frontend/ ./

EXPOSE 4200

# `npx ng serve` bypasses the npm prestart hook, so generate public/whats-new.json here first. It reads
# the CHANGELOG.md that docker-compose.dev.yml mounts at /CHANGELOG.md; a missing file only leaves the
# What's new panel empty and must not stop the dev server.
# --host 0.0.0.0 required to accept connections from outside the container
CMD ["sh", "-c", "npm run whats-new || echo 'whats-new.json not generated - the What is new panel stays empty'; exec npx ng serve --host 0.0.0.0 --port 4200"]
