JWT_SECRET=change-this-in-production
# Optional. Only needed if you use "Sign in with Google" on /login. Leave blank to disable.
GOOGLE_CLIENT_ID=your_google_oauth_client_id
# Org identity provider (OIDC). Leave empty to keep the OIDC sign-in off; the secret goes in docker/.env.sops.
AUTH_OIDC_AUTHORITY=
AUTH_OIDC_CLIENT_ID=
AUTH_OIDC_CLIENT_SECRET=
AUTH_OIDC_PUBLIC_BASE_URL=
# Optional. Where the API itself reaches the provider (prod default http://logto:3001/oidc over the identity-oidc network).
AUTH_OIDC_BACKCHANNEL_AUTHORITY=
# Optional, default true. Set false only for a local plain-HTTP provider; a plain-HTTP back channel forces it off anyway.
AUTH_OIDC_REQUIRE_HTTPS_METADATA=

# Production hostnames and edge addresses (docker-compose.prod.yml refuses to start without them).
# JWT_ISSUER: https origin the API is served under. FRONTEND_BASE_URL / TRUELAYER_FRONTEND_REDIRECT_BASE:
# frontend origin. PUBLIC_API_BASE_URL: API origin, matching the redirect URI registered with TrueLayer.
JWT_ISSUER=
FRONTEND_BASE_URL=
TRUELAYER_FRONTEND_REDIRECT_BASE=
PUBLIC_API_BASE_URL=
# Edge network between gateway and API. Forwarded headers are trusted only from the bridge (host ingress) and
# gateway addresses; the IP range keeps dynamic allocation off the gateway's pinned address.
# Example: subnet 10.231.77.0/29, bridge 10.231.77.1, gateway 10.231.77.2, range 10.231.77.4/30.
EDGE_SUBNET=
EDGE_IP_RANGE=
EDGE_BRIDGE_IP=
EDGE_GATEWAY_IP=

# IBKR credentials are collected per-user from the frontend connect form and
# stored encrypted in the `brokerage_sync.IBKRCredentials` table — never as
# environment variables here.

# TrueLayer Data API (PSD2 open banking for Revolut, AIB, and most EU/UK banks).
# Create a sandbox application at https://console.truelayer.com/ and copy the
# Client ID / Client Secret from the application settings page.
# Configure the redirect URI in Console to: http://localhost:5001/api/v1/accounts/truelayer/callback
TRUELAYER_CLIENT_ID=
TRUELAYER_CLIENT_SECRET=

# Finnhub (free tier — finnhub.io/register). Powers structured analyst recommendation
# trends (feature 037). Blank = trends capture silently off; scrapers unaffected.
FINNHUB_API_KEY=

# FRED (free — fred.stlouisfed.org/docs/api/api_key.html). Powers the 021 market-regime
# rates axis (10y-2y yield curve). Blank = rates axis silently unavailable; VIX axis
# (Yahoo ^VIX) works without a key.
FRED_API_KEY=

# Anthropic (console.anthropic.com). Powers the in-app finance agent / browser Ledger
# (feature 040) → Agent__Anthropic__ApiKey. Server-only, never client-exposed. Blank =
# the /ledger chat is disabled (keyless-graceful); the rest of the app is unaffected.
ANTHROPIC_API_KEY=

# Alt agent brain (feature 040): delegate the browser chat to the existing OpenClaw Ledger
# (finance) agent over its OpenAI-compatible gateway API — no Anthropic key needed. Auto-
# selected when ANTHROPIC_API_KEY is blank. URL = gateway base (bind: lan), e.g.
# http://172.17.0.1:18789. Token = OPENCLAW_GATEWAY_TOKEN (gateway auth mode: token).
OPENCLAW_GATEWAY_URL=
OPENCLAW_GATEWAY_TOKEN=

# Grafana (prod observability stack). Admin login for config changes; the
# GF_SECURITY_ADMIN_PASSWORD env only applies on first boot of an empty
# grafana_data volume — reset an existing instance with
#   docker exec finance-sentry-grafana grafana cli admin reset-admin-password <pw>
GRAFANA_ADMIN_PASSWORD=change-this-in-production
# Public URL Grafana is served under (e.g. the tailnet HTTPS address).
GRAFANA_ROOT_URL=

# Off-host encrypted database backups (feature 024). Nightly pg_dump is
# age-encrypted then uploaded to a Cloudflare R2 bucket; a weekly job restores
# it into an isolated scratch DB to prove recoverability. All blank = backup
# jobs no-op with a warning (dev/local safe).
#
# R2: create a bucket + an Account-scoped API token (Object Read & Write, applied
# to that bucket only) at https://dash.cloudflare.com → R2. Endpoint is
# https://<ACCOUNT_ID>.r2.cloudflarestorage.com
BACKUP_R2_ENDPOINT=
BACKUP_R2_BUCKET=finance-sentry-backups
BACKUP_R2_ACCESS_KEY=
BACKUP_R2_SECRET_KEY=
# Dedicated backup age keypair — generate with: age-keygen -o backup-age.key
#   RECIPIENT (public) encrypts dumps; IDENTITY (secret) is only used by the
#   restore-verify job to decrypt. Do NOT reuse the SOPS key.
BACKUP_AGE_RECIPIENT=
BACKUP_AGE_IDENTITY=
