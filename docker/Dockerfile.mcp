# syntax=docker/dockerfile:1
# Multi-stage build for FinanceSentry MCP server
# Build context: repository root

# Stage 1: Build
FROM mcr.microsoft.com/dotnet/sdk:10.0-alpine AS build
WORKDIR /src

# Restore into the layer filesystem (not a cache mount): a cache mount's contents are
# non-persistent under BuildKit GC/concurrent-build pressure, so a later RUN (publish)
# reading packages restored by an earlier RUN can find them missing (MSB3030/NETSDK1152).
ENV NUGET_PACKAGES=/src/.nuget/packages

# Project files first so the restore layer only rebuilds when a dependency changes. Restoring the
# MCP project (not the whole solution) pulls in just its own project graph.
COPY backend/Directory.*.props backend/
COPY --parents backend/src/**/*.csproj ./

WORKDIR /src/backend
RUN dotnet restore src/FinanceSentry.Mcp/FinanceSentry.Mcp.csproj

WORKDIR /src
COPY backend/ backend/

WORKDIR /src/backend
RUN dotnet build src/FinanceSentry.Mcp/FinanceSentry.Mcp.csproj -c Release --no-restore

RUN dotnet publish src/FinanceSentry.Mcp/FinanceSentry.Mcp.csproj -c Release -o /app/publish --no-build

# Stage 2: Runtime
FROM mcr.microsoft.com/dotnet/aspnet:10.0-alpine AS runtime
WORKDIR /app

# krb5-libs: without it Npgsql writes two raw "Cannot load library libgssapi_krb5.so.2" lines to
# stderr at first connect — plain text in a stdout stream that must be JSON (platform contract,
# spec 048). The api image installs it for the same reason.
RUN apk add --no-cache krb5-libs

COPY --from=build /app/publish .

ENV DOTNET_RUNNING_IN_CONTAINER=true

# Run as the image's non-root `app` user.
USER $APP_UID

ENTRYPOINT ["dotnet", "FinanceSentry.Mcp.dll"]
