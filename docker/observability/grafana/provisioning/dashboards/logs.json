{
  "uid": "fs-logs",
  "title": "Finance Sentry · Logs",
  "tags": ["finance-sentry", "us2"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "module",
        "label": "Module (regex)",
        "type": "textbox",
        "query": ".*",
        "current": { "text": ".*", "value": ".*" }
      },
      {
        "name": "level",
        "label": "Level (regex)",
        "type": "textbox",
        "query": ".*",
        "current": { "text": ".*", "value": ".*" }
      },
      {
        "name": "search",
        "label": "Free text",
        "type": "textbox",
        "query": "",
        "current": { "text": "", "value": "" }
      },
      {
        "name": "traceId",
        "label": "Trace id",
        "type": "textbox",
        "query": "",
        "current": { "text": "", "value": "" }
      }
    ]
  },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Log volume by level",
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        { "refId": "A", "expr": "sum by (level) (count_over_time({service_name=\"docker\"} |= `\"app\":\"finance-sentry\"` | json | app=\"finance-sentry\" | label_format level=`{{ or ._l \"Information\" }}` | module=~\"$module\" [$__auto]))", "legendFormat": "{{level}}" }
      ],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "bars", "fillOpacity": 60, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 2,
      "type": "logs",
      "title": "Logs — filter by module / level, free text, trace id",
      "description": "Structured app logs from the box collector's stdout pipeline (service_name=\"docker\"; app/module/level are read from the JSON line, not Loki labels). EF Core SQL is suppressed at the default level (FR-011); paste a W3C trace id to group one request's entries (SC-002).",
      "gridPos": { "h": 20, "w": 24, "x": 0, "y": 7 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        { "refId": "A", "expr": "{service_name=\"docker\"} |= `\"app\":\"finance-sentry\"` | json | app=\"finance-sentry\" | label_format level=`{{ or ._l \"Information\" }}` | module=~\"$module\" | level=~\"$level\" |~ \"(?i)$search\" |~ \"$traceId\"" }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": true,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      }
    }
  ]
}
