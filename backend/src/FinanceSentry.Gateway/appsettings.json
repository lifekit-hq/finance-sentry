{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",

  "Gateway": {
    "RateLimits": {
      "Auth": { "PermitPerMinute": 10 }
    },
    "SecurityHeaders": {
      "Content-Security-Policy": "default-src 'self'; script-src 'self' 'sha256-wqBF3++fqVx+m/jDAaLLzcRKrwRmnQtSd1SzrbvjlOY='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://assets.coincap.io https://financialmodelingprep.com https://www.google.com https://*.gstatic.com https://truelayer-provider-assets.s3.amazonaws.com; font-src 'self' data:; connect-src 'self' https://assets.coincap.io https://financialmodelingprep.com https://www.google.com https://*.gstatic.com https://truelayer-provider-assets.s3.amazonaws.com; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'",
      "X-Content-Type-Options": "nosniff",
      "X-Frame-Options": "DENY",
      "Referrer-Policy": "strict-origin-when-cross-origin",
      "Permissions-Policy": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
    },
    "PublicListener": {
      "Port": 0,
      "Routes": [ "auth-route", "api-route", "frontend-route" ]
    }
  },

  "LettuceEncrypt": {
    "DomainNames": [],
    "EmailAddress": "",
    "AcceptTermsOfService": false
  },

  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "api",
        "Order": 0,
        "RateLimiterPolicy": "auth",
        "Match": { "Path": "/api/v1/auth/{**catch-all}" }
      },
      "api-route": {
        "ClusterId": "api",
        "Order": 1,
        "Match": { "Path": "/api/{**catch-all}" }
      },
      "api-readiness-route": {
        "ClusterId": "api",
        "Order": 0,
        "Match": { "Path": "/api/v1/health/ready/{**catch-all}" }
      },
      "hangfire-route": {
        "ClusterId": "api",
        "Order": 1,
        "Match": { "Path": "/hangfire/{**catch-all}" }
      },
      "mcp-route": {
        "ClusterId": "mcp",
        "Order": 1,
        "Match": { "Path": "/mcp/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/mcp" }
        ]
      },
      "frontend-healthz-route": {
        "ClusterId": "frontend",
        "Order": 1,
        "Match": { "Path": "/healthz/{**catch-all}" }
      },
      "frontend-readyz-route": {
        "ClusterId": "frontend",
        "Order": 1,
        "Match": { "Path": "/readyz/{**catch-all}" }
      },
      "frontend-route": {
        "ClusterId": "frontend",
        "Order": 100,
        "Match": { "Path": "/{**catch-all}" }
      }
    },
    "Clusters": {
      "api": {
        "Destinations": {
          "api-1": { "Address": "http://api:5000/" }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:05:30"
        },
        "HealthCheck": {
          "Active": {
            "Enabled": "true",
            "Interval": "00:00:05",
            "Timeout": "00:00:03",
            "Policy": "ConsecutiveFailures",
            "Path": "/api/v1/health"
          },
          "Passive": {
            "Enabled": "true",
            "Policy": "TransportFailureRate",
            "ReactivationPeriod": "00:01:00"
          }
        }
      },
      "mcp": {
        "Destinations": {
          "mcp-1": { "Address": "http://mcp:5100/" }
        },
        "HealthCheck": {
          "Passive": {
            "Enabled": "true",
            "Policy": "TransportFailureRate",
            "ReactivationPeriod": "00:01:00"
          }
        }
      },
      "frontend": {
        "Destinations": {
          "frontend-1": { "Address": "http://frontend:4200/" }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": "true",
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/"
          }
        }
      }
    }
  }
}
